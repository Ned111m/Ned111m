{
  "$comment": "Endpoints are OpenAI-compatible (/v1/chat/completions). Edit models to what is pulled/loaded locally. Strata keeps its own config; this router only reads endpoint load and never restarts/unloads anything.",
  "endpoints": {
    "llama-server": { "base": "http://127.0.0.1:8080/v1", "busyProbe": "llama-slots", "apiKeyEnv": "LLAMA_API_KEY" },
    "ollama": { "base": "http://127.0.0.1:11434/v1", "busyProbe": "ollama-ps", "apiKeyEnv": null }
  },
  "tasks": {
    "seo-metadata": { "endpoint": "ollama", "model": "qwen3:14b", "temperature": 0.4, "maxTokens": 1800, "json": true, "prompt": "prompts/seo-metadata.md" },
    "script-outline": { "endpoint": "llama-server", "model": "default", "temperature": 0.7, "maxTokens": 2500, "json": false, "prompt": "prompts/script-outline.md" },
    "thumbnail-concepts": { "endpoint": "ollama", "model": "qwen3:14b", "temperature": 0.9, "maxTokens": 1200, "json": true, "prompt": "prompts/thumbnail-concepts.md" },
    "chapters": { "endpoint": "ollama", "model": "qwen3:14b", "temperature": 0.2, "maxTokens": 800, "json": true, "prompt": "prompts/chapters.md" }
  }
}
