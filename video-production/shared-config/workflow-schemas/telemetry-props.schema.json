{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dronmaglaj.local/schemas/telemetry-props.schema.json",
  "title": "Remotion telemetry props (DJI SRT -> per-frame samples)",
  "type": "object",
  "required": ["version", "fps", "durationInFrames", "source", "bounds", "samples"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "fps": { "$ref": "_defs.schema.json#/$defs/fps" },
    "durationInFrames": { "type": "integer", "minimum": 1 },
    "source": {
      "type": "object",
      "required": ["file", "device"],
      "properties": {
        "file": { "type": "string" },
        "device": { "type": "string" },
        "startTime": { "type": ["string", "null"] },
        "hasGps": { "type": "boolean" }
      }
    },
    "bounds": {
      "type": "object",
      "required": ["minLat", "maxLat", "minLon", "maxLon", "minAlt", "maxAlt", "maxSpeedMs", "totalDistanceM"],
      "additionalProperties": { "type": ["number", "null"] }
    },
    "samples": {
      "description": "Exactly durationInFrames entries; samples[i].frame === i (O(1) lookup in Remotion).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["frame", "t", "lat", "lon", "relAlt", "speedMs", "vSpeedMs", "distanceM"],
        "properties": {
          "frame": { "$ref": "_defs.schema.json#/$defs/frame" },
          "t": { "$ref": "_defs.schema.json#/$defs/seconds" },
          "lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
          "lon": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
          "relAlt": { "type": ["number", "null"] },
          "absAlt": { "type": ["number", "null"] },
          "speedMs": { "type": "number", "minimum": 0 },
          "vSpeedMs": { "type": "number" },
          "headingDeg": { "type": ["number", "null"], "minimum": 0, "maximum": 360 },
          "distanceM": { "type": "number", "minimum": 0 },
          "iso": { "type": ["number", "null"] },
          "shutter": { "type": ["string", "null"] },
          "fnum": { "type": ["number", "null"] },
          "ev": { "type": ["number", "null"] },
          "ct": { "type": ["number", "null"] },
          "focalLen": { "type": ["number", "null"] },
          "colorMd": { "type": ["string", "null"] }
        }
      }
    }
  }
}
